{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Generated from the C64 IDE VisionBASIC 1.1 plugin definition.",
    "Do not edit by hand \u2014 regenerate instead."
  ],
  "name": "Vision BASIC",
  "scopeName": "source.visionbasic",
  "fileTypes": ["bas", "vb64", "vbas"],
  "patterns": [
    {
      "include": "#line_number"
    },
    {
      "include": "#rem_comment"
    },
    {
      "include": "#asm_comment"
    },
    {
      "include": "#asm_block"
    },
    {
      "include": "#string"
    },
    {
      "include": "#hex_number"
    },
    {
      "include": "#binary_number"
    },
    {
      "include": "#multiword_keywords"
    },
    {
      "include": "#label_definition"
    },
    {
      "include": "#tag_definition"
    },
    {
      "include": "#line_reference"
    },
    {
      "include": "#unimplemented"
    },
    {
      "include": "#assembler_keywords"
    },
    {
      "include": "#editor_keywords"
    },
    {
      "include": "#conditional_keywords"
    },
    {
      "include": "#loop_keywords"
    },
    {
      "include": "#flow_keywords"
    },
    {
      "include": "#variable_keywords"
    },
    {
      "include": "#operator_keywords"
    },
    {
      "include": "#math_keywords"
    },
    {
      "include": "#string_keywords"
    },
    {
      "include": "#graphics_keywords"
    },
    {
      "include": "#sound_keywords"
    },
    {
      "include": "#screen_keywords"
    },
    {
      "include": "#memory_keywords"
    },
    {
      "include": "#io_keywords"
    },
    {
      "include": "#system_keywords"
    },
    {
      "include": "#proc_call"
    },
    {
      "include": "#string_variable"
    },
    {
      "include": "#pi_constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#statement_separator"
    },
    {
      "include": "#variable"
    }
  ],
  "repository": {
    "line_number": {
      "name": "constant.numeric.line-number.visionbasic",
      "match": "^\\s*\\d+(?=\\s|$)"
    },
    "rem_comment": {
      "name": "comment.line.rem.visionbasic",
      "begin": "(?i)\\bREM\\b",
      "end": "$",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.rem.visionbasic"
        }
      },
      "patterns": [
        {
          "include": "#todo"
        }
      ]
    },
    "todo": {
      "name": "keyword.other.todo.visionbasic",
      "match": "(?i)\\b(TODO|FIXME|NOTE|XXX|HACK)\\b"
    },
    "asm_block": {
      "name": "meta.embedded.block.assembly.visionbasic",
      "begin": "\\[",
      "end": "\\]|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.assembly.begin.visionbasic"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.assembly.end.visionbasic"
        }
      },
      "patterns": [
        {
          "include": "#asm_comment"
        },
        {
          "include": "#asm_mnemonic"
        },
        {
          "include": "#asm_immediate"
        },
        {
          "include": "#hex_number"
        },
        {
          "include": "#binary_number"
        },
        {
          "include": "#number"
        },
        {
          "include": "#asm_register"
        },
        {
          "include": "#string"
        }
      ]
    },
    "asm_comment": {
      "name": "comment.line.semicolon.visionbasic",
      "match": ";.*$"
    },
    "asm_mnemonic": {
      "name": "keyword.operator.mnemonic.visionbasic",
      "match": "(?i)\\b(?:ADC|AND|ASL|BCC|BCS|BEQ|BIT|BMI|BNE|BPL|BRK|BVC|BVS|CLC|CLD|CLI|CLV|CMP|CPX|CPY|DEC|DEX|DEY|EOR|INC|INX|INY|JMP|JSR|LDA|LDX|LDY|LSR|NOP|ORA|PHA|PHP|PLA|PLP|ROL|ROR|RTI|RTS|SBC|SEC|SED|SEI|STA|STX|STY|TAX|TAY|TSX|TXA|TXS|TYA)\\b"
    },
    "asm_immediate": {
      "name": "keyword.operator.immediate.visionbasic",
      "match": "#"
    },
    "asm_register": {
      "name": "variable.language.register.visionbasic",
      "match": "(?i)(?<=,)\\s*[AXY]\\b"
    },
    "string": {
      "name": "string.quoted.double.visionbasic",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.visionbasic"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.visionbasic"
        }
      },
      "patterns": [
        {
          "include": "#petscii_escape"
        }
      ]
    },
    "petscii_escape": {
      "name": "constant.character.escape.petscii.visionbasic",
      "match": "\\{[^}\"]*\\}"
    },
    "hex_number": {
      "name": "constant.numeric.hex.visionbasic",
      "match": "\\$[0-9A-Fa-f]+"
    },
    "binary_number": {
      "name": "constant.numeric.binary.visionbasic",
      "match": "%[01]+"
    },
    "number": {
      "name": "constant.numeric.decimal.visionbasic",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "pi_constant": {
      "name": "constant.language.pi.visionbasic",
      "match": "\u03c0"
    },
    "label_definition": {
      "match": "(?i)\\b(DESC)\\s+(\\d+)\\s*,\\s*([A-Za-z][A-Za-z0-9!@#%&?]*)",
      "captures": {
        "1": {
          "name": "keyword.control.editor.visionbasic"
        },
        "2": {
          "name": "constant.numeric.line-number.visionbasic"
        },
        "3": {
          "name": "entity.name.function.visionbasic"
        }
      }
    },
    "tag_definition": {
      "match": "(?i)\\b(TAG|LABEL|PROC)\\s+([A-Za-z][A-Za-z0-9!@#%&?]*)",
      "captures": {
        "1": {
          "name": "storage.type.visionbasic"
        },
        "2": {
          "name": "entity.name.function.visionbasic"
        }
      }
    },
    "proc_call": {
      "match": "(?i)(?<![A-Za-z0-9$#.])([A-Za-z][A-Za-z0-9!@#%&?]*)(\\.)(?=[A-Za-z0-9\"$])",
      "captures": {
        "1": {
          "name": "entity.name.function.call.visionbasic"
        },
        "2": {
          "name": "punctuation.separator.parameter.visionbasic"
        }
      }
    },
    "line_reference": {
      "match": "(?i)\\b(GOTO|GOSUB|THEN|ELSE)\\s+(\\d+)",
      "captures": {
        "1": {
          "name": "keyword.control.flow.visionbasic"
        },
        "2": {
          "name": "constant.numeric.line-number.reference.visionbasic"
        }
      }
    },
    "multiword_keywords": {
      "name": "keyword.control.visionbasic",
      "match": "(?i)\\b(?:MODULE\\s+END|POINT\\s+TAG)\\b"
    },
    "unimplemented": {
      "name": "invalid.deprecated.unimplemented.visionbasic",
      "match": "(?i)\\b(?:ATN|COS|EXP|FRE|LOG|POS|SIN|SQR|TAN|USR)(?![A-Za-z0-9$#])"
    },
    "assembler_keywords": {
      "name": "keyword.control.assembler.visionbasic",
      "match": "(?i)\\b(?:ASSEM|BASIC|LABEL|START|SYS)(?![A-Za-z0-9$#])"
    },
    "editor_keywords": {
      "name": "keyword.control.editor.visionbasic",
      "match": "(?i)\\b(?:DELETE|LISTER|MODULE|RESUME|ERROR|LLIST|PLIST|RENUM|VLIST|AUTO|COMP|CONT|DESC|EXEC|FIND|HALT|LIST|LITE|PREV|QUIT|NEW|OLD|RUN)(?![A-Za-z0-9$#])"
    },
    "conditional_keywords": {
      "name": "keyword.control.conditional.visionbasic",
      "match": "(?i)\\b(?:ELSE|THEN|IF)(?![A-Za-z0-9$#])"
    },
    "loop_keywords": {
      "name": "keyword.control.loop.visionbasic",
      "match": "(?i)\\b(?:NEXT|STEP|FOR|DO|TO)(?![A-Za-z0-9$#])"
    },
    "flow_keywords": {
      "name": "keyword.control.flow.visionbasic",
      "match": "(?i)\\b(?:RETURN|GOSUB|POINT|TREND|GOTO|PASS|PROC|SEND|STOP|TRAP|END|ON)(?![A-Za-z0-9$#])"
    },
    "variable_keywords": {
      "name": "storage.type.visionbasic",
      "match": "(?i)\\b(?:VARIABLES|DECIMAL|INTEGER|GLOBAL|LOCAL|DUBL|CLR|DEF|DIM|LET|SUB|TAG)(?![A-Za-z0-9$#])"
    },
    "operator_keywords": {
      "name": "keyword.operator.word.visionbasic",
      "match": "(?i)\\b(?:AND|EOR|NOT|OR)(?![A-Za-z0-9$#])"
    },
    "math_keywords": {
      "name": "support.function.math.visionbasic",
      "match": "(?i)\\b(?:SUBTRACT|COMPARE|DOUBLE|RANDOM|SPLIT|WHOLE|FRAC|HALF|JOIN|ABS|ADD|DEC|INC|INT|RND|SGN|FN|\u03c0)(?![A-Za-z0-9$#])"
    },
    "string_keywords": {
      "name": "support.function.string.visionbasic",
      "match": "(?i)\\b(?:RIGHT\\$|LEFT\\$|CHR\\$|DUP\\$|MID\\$|STR\\$|ASC|LEN|VAL)(?![A-Za-z0-9$#])"
    },
    "graphics_keywords": {
      "name": "support.function.graphics.visionbasic",
      "match": "(?i)\\b(?:COLLISION|ALLMOBS|BITMAP|BMPCLR|BMPCOL|BMPLOC|DETECT|LIMITS|MOBCLR|MOBCOL|MOBEXP|MOBPAT|MOBSET|HLINE|MOBXY|SHAPE|VLINE|LINE|PLOT|MOB)(?![A-Za-z0-9$#])"
    },
    "sound_keywords": {
      "name": "support.function.sound.visionbasic",
      "match": "(?i)\\b(?:CUTOFF|FILTER|SIDCLR|PULSE|VOICE|ADSR|FREQ|WAVE|VOL)(?![A-Za-z0-9$#])"
    },
    "screen_keywords": {
      "name": "support.function.screen.visionbasic",
      "match": "(?i)\\b(?:LOWERCASE|UPPERCASE|EXTENDED|CHARPAT|CHARSET|COPYSET|COLORS|NORMAL|VIDLOC|BLANK|CATCH|MULTI|PRINT|PANX|PANY|SPC|TAB|CLS|LOC)(?![A-Za-z0-9$#])"
    },
    "memory_keywords": {
      "name": "support.function.memory.visionbasic",
      "match": "(?i)\\b(?:LONGPEEK|LONGPOKE|REUPEEK|REUPOKE|STRINGS|DETEXT|SWITCH|BYTES|FETCH|STASH|BANK|CODE|COPY|FILL|PEEK|POKE|SWAP)(?![A-Za-z0-9$#])"
    },
    "io_keywords": {
      "name": "support.function.io.visionbasic",
      "match": "(?i)\\b(?:KEYPRESS|BUTTON|DEVICE|INPUT\\#|PADBUT|PADDLE|PRINT\\#|STATUS|VERIFY|CLOSE|GSAVE|INPUT|DISK|FILE|GET\\#|LOAD|OPEN|POLL|SAVE|CMD|DIR|GET|JOY)(?![A-Za-z0-9$#])"
    },
    "system_keywords": {
      "name": "support.function.system.visionbasic",
      "match": "(?i)\\b(?:INTERRUPT|STARTINT|HALTINT|RESTORE|VERSION|INTEND|RASTER|CLOCK|DEBUG|PAUSE|DATA|FAST|READ|SLOW|WAIT|REM)(?![A-Za-z0-9$#])"
    },
    "string_variable": {
      "name": "variable.other.string.visionbasic",
      "match": "(?i)\\b[A-Za-z][A-Za-z0-9!@#%&?]{0,7}\\$"
    },
    "variable": {
      "name": "variable.other.visionbasic",
      "match": "(?i)\\b[A-Za-z][A-Za-z0-9!@#%&?]{0,7}\\b"
    },
    "operators": {
      "name": "keyword.operator.visionbasic",
      "match": "<>|<=|>=|[+\\-*/<>=^]"
    },
    "statement_separator": {
      "name": "punctuation.terminator.statement.visionbasic",
      "match": ":"
    }
  }
}
